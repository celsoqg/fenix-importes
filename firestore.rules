rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catálogo e configurações: leitura pública para a vitrine, escrita apenas pelo Admin autenticado
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Pedidos: cliente cria pedido e consulta rastreio; edição/exclusão apenas pelo Admin autenticado
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    // Avaliações: leitura e envio públicos; exclusão apenas pelo Admin autenticado
    match /feedbacks/{feedbackId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
